
#include <stdio.h>

struct Student {
    int roll;
    char name[50];
    float marks;
};

int main() {
    struct Student s[50];
    int n, i;

    printf("How many students? ");
    scanf("%d", &n);

    for(i = 0; i < n; i++) {
        printf("\nEnter Roll No: ");
        scanf("%d", &s[i].roll);

        printf("Enter Name: ");
        scanf("%49s", s[i].name);

        printf("Enter Marks: ");
        scanf("%f", &s[i].marks);
    }

    printf("\n--- STUDENT RECORDS ---\n");

    for(i = 0; i < n; i++) {
        printf("\nRoll: %d", s[i].roll);
        printf("\nName: %s", s[i].name);
        printf("\nMarks: %.2f", s[i].marks);
        printf("\nPercentage: %.2f%%\n", s[i].marks);
    }

    return 0;
}
